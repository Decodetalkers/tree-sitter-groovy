{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "groovy",
      "camelcase": "Groovy",
      "title": "Groovy",
      "scope": "source.groovy",
      "file-types": [
        "groovy"
      ],
      "injection-regex": "^groovy$",
      "class-name": "TreeSitterGroovy"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "tree-sitter for groovy",
    "authors": [
      {
        "name": "Decodetalkers",
        "email": "aakari@tutanota.com",
        "url": "https://github.com/Decodetalkers"
      }
    ],
    "links": {
      "repository": "https://github.com/Decodetalkers/tree-sitter-groovy",
      "funding": "https://github.com/sponsors/Decodetalkers"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
