{
  "name": "tree-sitter-groovy",
  "version": "0.0.2",
  "description": "A tree-sitter for groovy dsl",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "lint": "prettier --check grammar.js",
    "format": "prettier --write grammar.js",
    "build": "tree-sitter generate",
    "test": "tree-sitter test",
    "gyp_build": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "keywords": [],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "author": "Decodetalkers",
  "gypfile": false,
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "prettier": "^3.9.10",
    "tree-sitter-cli": "^0.27.2"
  },
  "tree-sitter": [
    {
      "scope": "source.groovy",
      "injection-regex": "^groovy$"
    }
  ]
}
